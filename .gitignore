new_models/
comparison/

# --- Simulator / dataset caches (regenerable) ---
*.npz
*_cache/
datasets/

# --- Personal records (a phone-authored sync database is patient data; never commit one) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Generated figures / cards / screenshots ---
figures/
t1dmai_screenshot_*.png

# --- Generated metrics reports (keep metrics/*.py + rebuild_all.sh) ---
metrics/**/figures/
metrics/**/README.md
metrics/**/stats.json
metrics/*.json
# curvegen is source, not a generated report; its README is written by hand.
!metrics/curvegen/README.md

